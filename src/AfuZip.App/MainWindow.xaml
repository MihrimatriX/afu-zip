<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AfuZip.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:AfuZip.Core"
    xmlns:services="using:AfuZip.App.Services"
    Title="AFU Zip">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Üç satır: başlık çubuğundaki sekmeler, içerik, tek durum çubuğu. -->
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="OnCloseTabAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnCreateAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Başlık çubuğu = sekme şeridi (Terminal ve Gezgin gibi). Boş kısım pencereyi sürükler. -->
        <Grid x:Name="TitleArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" Margin="14,4,6,0" VerticalAlignment="Center" />
            <TabView x:Name="Tabs" Grid.Column="1" VerticalAlignment="Bottom"
                     IsAddTabButtonVisible="True" TabWidthMode="SizeToContent" CanReorderTabs="True"
                     AddTabButtonClick="OnAddTabClick"
                     TabCloseRequested="OnTabCloseRequested"
                     SelectionChanged="OnTabSelectionChanged">
                <TabView.TabStripFooter>
                    <Grid x:Name="DragRegion" Background="Transparent" MinWidth="160" />
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <!-- İçerik: başlangıç ekranı ya da seçili sekmenin görünümü (görünümler kodda eklenir, açık kalır). -->
        <Grid x:Name="ViewHost" Grid.Row="1">
            <ScrollViewer x:Name="Home" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1000" Padding="32,20,32,24" Spacing="14" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="HomeIcon" Width="44" Height="44" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Arşiv açın ya da buraya sürükleyin" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Arşivler yeni sekmede açılır; arşiv olmayan dosya ve klasörlerden yeni arşiv oluşturulur." />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="OnOpenClick" ToolTipService.ToolTip="Ctrl+O">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Arşiv aç" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnCreateClick" ToolTipService.ToolTip="Ctrl+N">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                                    <TextBlock Text="Arşiv oluştur" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <InfoBar x:Name="EngineWarning" IsClosable="True" Severity="Warning" Title="7-Zip bulunamadı"
                             Message="Yalnızca zip, tar ve tar.gz açılabilir. 7z, RAR, ISO ve diğer biçimler için 7-Zip veya 7-Zip ZS kurun.">
                        <InfoBar.ActionButton>
                            <HyperlinkButton Content="7-Zip ZS'yi indir" NavigateUri="https://github.com/mcmilk/7-Zip-zstd/releases/latest" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="ShellSuggestion" IsClosable="True" Severity="Informational" Title="Explorer'a ekleyin"
                             Message="Arşivlere sağ tıklayınca &quot;Buraya çıkar&quot;, dosyalara sağ tıklayınca &quot;Sıkıştır&quot; çıksın.">
                        <InfoBar.ActionButton>
                            <Button Content="Sağ tık menüsüne ekle" Click="OnSuggestionRegister" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <TextBlock Text="Son açılanlar" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="0,4"
                            Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay}">
                        <ListView ItemsSource="{x:Bind ViewModel.Recent}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnRecentClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="44" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:RecentItem">
                                    <Grid ColumnSpacing="14" ToolTipService.ToolTip="{x:Bind Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xF012;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Folder}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind DateText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <Border BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="24,28" Visibility="{x:Bind ViewModel.HasNoRecent, Mode=OneWay}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Henüz açılan arşiv yok" HorizontalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="7z, ZIP, RAR, TAR, ISO, CAB, WIM ve 7-Zip'in tanıdığı diğer biçimler." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ProgressBar VerticalAlignment="Top" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>

        <!-- Durum çubuğu: seçili sekmenin durumu ve arşiv özeti, görevler, ayarlar. -->
        <Grid Grid.Row="2" Padding="14,0,6,0" ColumnSpacing="16"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560"
                       Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.CurrentStatus, Mode=OneWay}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.CurrentSummary, Mode=OneWay}" />

            <Button Grid.Column="2" Padding="8,2" Background="Transparent" BorderThickness="0"
                    Visibility="{x:Bind ViewModel.HasTasks, Mode=OneWay}" ToolTipService.ToolTip="Görevler">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressBar Width="72" VerticalAlignment="Center" Maximum="100"
                                 Value="{x:Bind ViewModel.TasksPercent, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.HasActiveTasks, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.TasksHeader, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight">
                        <Grid Width="440" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Görevler" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <HyperlinkButton HorizontalAlignment="Right" Content="Bitenleri temizle" Click="OnClearTasks" />
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tasks}" SelectionMode="None" MaxHeight="360">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:ArchiveTask">
                                        <Grid Padding="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100"
                                                             IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                             Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" TextWrapping="Wrap"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button ToolTipService.ToolTip="Duraklat" Click="OnPauseTask" Tag="{x:Bind}"
                                                        Visibility="{x:Bind CanPause, Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE769;" FontSize="12" />
                                                </Button>
                                                <Button ToolTipService.ToolTip="Devam et" Click="OnResumeTask" Tag="{x:Bind}"
                                                        Visibility="{x:Bind CanResume, Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                </Button>
                                                <Button ToolTipService.ToolTip="İptal" Click="OnCancelTask" Tag="{x:Bind}"
                                                        Visibility="{x:Bind IsActive, Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Grid.Column="3" Padding="8,2" Background="Transparent" BorderThickness="0" Click="OnSettingsClick"
                    ToolTipService.ToolTip="Ayarlar (Ctrl+,)" AutomationProperties.Name="Ayarlar">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                    <TextBlock Text="Ayarlar" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
