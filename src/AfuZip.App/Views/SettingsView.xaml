<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AfuZip.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="Açık" />
            <Setter Property="OffContent" Value="Kapalı" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <!-- Windows 11 Ayarlar düzeni: simge · başlık ve açıklama · denetim -->
        <Style x:Key="Card" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style x:Key="CardIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,20,0,6" />
        </Style>
        <Style x:Key="Choice" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{ThemeResource ChromeBrush}">
        <StackPanel MaxWidth="860" Padding="24,12,24,32" Spacing="4" HorizontalAlignment="Stretch">
            <TextBlock Text="Ayarlar" Style="{StaticResource SubtitleTextBlockStyle}" Margin="2,4,0,0" />
            <InfoBar x:Name="Notice" IsClosable="True" Margin="0,8,0,0" />

            <TextBlock Text="Görünüm" Style="{StaticResource Section}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Tema" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Sistem seçeneği Windows'un açık/koyu ayarını izler." Style="{StaticResource CardText}" />
                </StackPanel>
                <ComboBox x:Name="ThemeBox" Grid.Column="2" Style="{StaticResource Choice}">
                    <x:String>Sistem</x:String>
                    <x:String>Açık</x:String>
                    <x:String>Koyu</x:String>
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Klasör ağacı" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Listenin solunda arşivin klasörleri. Kapalıyken adres çubuğuyla gezilir." Style="{StaticResource CardText}" />
                </StackPanel>
                <ToggleSwitch x:Name="TreeToggle" Grid.Column="2" />
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8FD;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Sıkışık satırlar" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Listede daha çok dosya görünür." Style="{StaticResource CardText}" />
                </StackPanel>
                <ToggleSwitch x:Name="CompactToggle" Grid.Column="2" />
            </Grid>

            <TextBlock Text="Sıkıştırma" Style="{StaticResource Section}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7B8;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Varsayılan amaç" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Yeni arşiv penceresi bu amaçla açılır." Style="{StaticResource CardText}" />
                </StackPanel>
                <ComboBox x:Name="PresetBox" Grid.Column="2" Style="{StaticResource Choice}" />
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8E5;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Oluşturunca arşivi aç" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Arşiv bitince yeni sekmede açılır." Style="{StaticResource CardText}" />
                </StackPanel>
                <ToggleSwitch x:Name="OpenCreatedToggle" Grid.Column="2" />
            </Grid>

            <TextBlock Text="Çıkarma" Style="{StaticResource Section}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE896;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="&quot;Buraya çıkar&quot;" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Akıllı: arşivde tek klasör varsa doğrudan çıkarır, birden çok öğe varsa dağılmasın diye klasör açar." Style="{StaticResource CardText}" />
                </StackPanel>
                <ComboBox x:Name="ExtractModeBox" Grid.Column="2" Style="{StaticResource Choice}">
                    <x:String>Akıllı</x:String>
                    <x:String>Her zaman klasöre</x:String>
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE838;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Bitince klasörü aç" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Çıkarılan klasör Explorer'da açılır." Style="{StaticResource CardText}" />
                </StackPanel>
                <ToggleSwitch x:Name="RevealToggle" Grid.Column="2" />
            </Grid>

            <TextBlock Text="Windows" Style="{StaticResource Section}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8A7;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Explorer sağ tık menüsü ve &quot;Birlikte aç&quot;" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Arşivlerde aç, buraya çıkar, klasöre çıkar, test et; her dosyada arşive ekle, 7z veya zip olarak sıkıştır. Windows 11'de imzalı menü paketi varsa doğrudan sağ tık menüsünde, yoksa &quot;Daha fazla seçenek göster&quot; altında. Yalnızca sizin hesabınıza kaydedilir." Style="{StaticResource CardText}" />
                </StackPanel>
                <ToggleSwitch x:Name="ShellToggle" Grid.Column="2" />
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7AC;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Varsayılan arşiv uygulaması" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Windows Ayarlar'da arşiv türlerini AFU Zip'e bağlayın." Style="{StaticResource CardText}" />
                </StackPanel>
                <Button x:Name="DefaultAppsButton" Grid.Column="2" Content="Ayarları aç" />
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xEA8F;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Bildirimler" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Sağ tık işleri bitince &quot;Klasörü aç&quot; düğmeli bildirim." Style="{StaticResource CardText}" />
                </StackPanel>
                <ToggleSwitch x:Name="NotifyToggle" Grid.Column="2" />
            </Grid>

            <TextBlock Text="Sıkıştırma motoru" Style="{StaticResource Section}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE950;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="EngineTitle" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="EngineText" Style="{StaticResource CardText}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="EngineFolderButton" Content="Klasörü aç" />
                    <HyperlinkButton Content="7-Zip ZS" NavigateUri="https://github.com/mcmilk/7-Zip-zstd/releases/latest" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Hakkında" Style="{StaticResource Section}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Image x:Name="AboutIcon" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="MIT lisanslı, açık kaynak. 7z.dll kurulu 7-Zip'ten yüklenir (GNU LGPL)." Style="{StaticResource CardText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/MihrimatriX/afu-zip" />
                    <HyperlinkButton x:Name="LogFolderButton" Content="Günlük klasörü" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
