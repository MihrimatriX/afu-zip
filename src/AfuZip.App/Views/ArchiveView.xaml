<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AfuZip.App.Views.ArchiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AfuZip.App.ViewModels"
    xmlns:views="using:AfuZip.App.Views">

    <!--
        Sade düzen: simge komutlar · konum · arama/menü tek satırda, altında liste.
        Seyrek kullanılanlar (yeniden adlandır, sütunlar, arşiv bilgisi) sağ tık ve ⋯ menüsünde.
    -->
    <Grid x:Name="Root" Background="{ThemeResource ChromeBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Margin" Value="12,0,0,0" />
                <!-- Caption stili kaydırmalı: gizlenen (0 genişlikli) sütunda her harf bir satıra düşüp satırı uzatıyordu -->
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="MaxLines" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnExtractHereAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Up" Invoked="OnUpAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tek satır: ↓ + 🗑 ✓ │ konum │ 🔍 ⋯ -->
        <Grid Padding="4,0,4,0" Height="44" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandBar Background="Transparent" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="False"
                        OverflowButtonVisibility="Collapsed" VerticalAlignment="Center">
                <AppBarButton Icon="Download" Label="Çıkar" Width="44" ToolTipService.ToolTip="Çıkar"
                              IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Buraya çıkar" Click="OnExtractHere" KeyboardAcceleratorTextOverride="Ctrl+E" />
                            <MenuFlyoutItem Text="Klasöre çıkar…" Click="OnExtractAllTo" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Seçilenleri buraya çıkar" Click="OnExtractSelectionHere"
                                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                            <MenuFlyoutItem Text="Seçilenleri klasöre çıkar…" Click="OnExtractSelectionTo"
                                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Add" Label="Ekle" Width="44" ToolTipService.ToolTip="Ekle (listeye sürükleyerek de olur)"
                              IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Dosya ekle…" Click="OnAddFiles" />
                            <MenuFlyoutItem Text="Klasör ekle…" Click="OnAddFolder" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Delete" Label="Sil" Width="44" Click="OnDelete" ToolTipService.ToolTip="Sil (Del)"
                              IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}" />
                <AppBarButton Label="Test et" Width="44" Click="OnTest" ToolTipService.ToolTip="Test et"
                              IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE73E;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <!-- Konum: arşiv › iç arşiv › klasör (kutusuz) -->
            <BreadcrumbBar Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                           ItemsSource="{x:Bind ViewModel.Breadcrumb}" ItemClicked="OnBreadcrumbClicked" />

            <!-- Arama: simge; tıklanınca (ya da Ctrl+F) kutuya dönüşür, boş bırakılınca kapanır -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="SearchBox" Width="220" QueryIcon="Find" Visibility="Collapsed"
                                PlaceholderText="Arşivde ara" AutomationProperties.Name="Arşivde ara"
                                Text="{x:Bind ViewModel.SearchText, Mode=OneWay}" TextChanged="OnSearchTextChanged"
                                LostFocus="OnSearchLostFocus" KeyDown="OnSearchKeyDown" />
            </Grid>

            <CommandBar Grid.Column="3" Background="Transparent" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="False"
                        OverflowButtonVisibility="Collapsed" VerticalAlignment="Center">
                <AppBarButton x:Name="SearchButton" Icon="Find" Label="Ara" Width="44" Click="OnSearchButtonClick"
                              ToolTipService.ToolTip="Ara (Ctrl+F)" />
                <AppBarButton x:Name="MoreButton" Label="Diğer" Width="44" ToolTipService.ToolTip="Arşiv bilgisi ve görünüm">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE712;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnViewMenuOpening">
                            <MenuFlyoutItem Text="Arşiv bilgisi" Click="OnShowInfo">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="Sütunlar">
                                <ToggleMenuFlyoutItem x:Name="ModifiedColumnItem" Text="Değiştirilme" Click="OnToggleColumn" />
                                <ToggleMenuFlyoutItem x:Name="RatioColumnItem" Text="Oran" Click="OnToggleColumn" />
                                <ToggleMenuFlyoutItem x:Name="MethodColumnItem" Text="Yöntem" Click="OnToggleColumn" />
                                <ToggleMenuFlyoutItem x:Name="PackedColumnItem" Text="Sıkıştırılmış boyut" Click="OnToggleColumn" />
                            </MenuFlyoutSubItem>
                            <ToggleMenuFlyoutItem x:Name="TreeMenuItem" Text="Klasör ağacı" Click="OnToggleTree" />
                            <ToggleMenuFlyoutItem x:Name="CompactMenuItem" Text="Sıkışık satırlar" Click="OnToggleCompact" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <!-- Kalıcı uyarılar: sorunlu arşiv, dışarıda değiştirilen dosya -->
        <StackPanel Grid.Row="1">
            <InfoBar Margin="8,0,8,6" Severity="Warning" IsClosable="True" Title="Arşivde sorun var"
                     IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}" Message="{x:Bind ViewModel.Warning, Mode=OneWay}" />
            <InfoBar Margin="8,0,8,6" Severity="Informational" IsClosable="True"
                     IsOpen="{x:Bind ViewModel.HasPendingEdits, Mode=OneWay}"
                     Title="Dosya dışarıda değiştirildi"
                     Message="{x:Bind ViewModel.PendingEditsMessage, Mode=OneWay}"
                     CloseButtonClick="OnDismissExternalEdits">
                <InfoBar.ActionButton>
                    <Button Content="Arşivde güncelle" Click="OnApplyExternalEdits" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Gövde: [ağaç | ayraç] liste -->
        <Grid x:Name="Body" Grid.Row="2" Background="{ThemeResource BodyBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree" Padding="0,4" ItemsSource="{x:Bind ViewModel.FolderRoots}" SelectionMode="Single"
                      CanDragItems="False" CanReorderItems="False" AllowDrop="False" Visibility="Collapsed"
                      ItemInvoked="OnFolderInvoked">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderNodeViewModel">
                        <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <views:SplitterHandle x:Name="TreeSplitter" Grid.Column="1" Visibility="Collapsed" />

            <Grid x:Name="ListPane" Grid.Column="2" SizeChanged="OnListPaneSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sıralanabilir kolon başlıkları. Görünen sütunlar ayar + genişliğe göre (UpdateColumns). -->
                <Grid x:Name="HeaderGrid" Height="28" Padding="14,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left" Tag="Name" Click="OnSortClick"
                            Content="{x:Bind ViewModel.NameHeader, Mode=OneWay}" />
                    <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Tag="Size" Click="OnSortClick"
                            Content="{x:Bind ViewModel.SizeHeader, Mode=OneWay}" />
                    <Button Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Tag="PackedSize" Click="OnSortClick"
                            Content="{x:Bind ViewModel.PackedHeader, Mode=OneWay}" />
                    <Button Grid.Column="3" Margin="12,0,0,0" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Tag="Ratio" Click="OnSortClick"
                            Content="{x:Bind ViewModel.RatioHeader, Mode=OneWay}" />
                    <Button Grid.Column="4" Margin="12,0,0,0" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left" Tag="Method" Click="OnSortClick"
                            Content="{x:Bind ViewModel.MethodHeader, Mode=OneWay}" />
                    <Button Grid.Column="5" Margin="12,0,0,0" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left" Tag="Modified" Click="OnSortClick"
                            Content="{x:Bind ViewModel.ModifiedHeader, Mode=OneWay}" />
                </Grid>

                <ListView x:Name="EntriesList" Grid.Row="1" Padding="0,0,0,4"
                          ItemsSource="{x:Bind ViewModel.Items}"
                          ItemContainerStyle="{StaticResource CompactRowStyle}"
                          SelectionMode="Extended"
                          IsDoubleTapEnabled="True"
                          SelectionChanged="OnSelectionChanged"
                          DoubleTapped="OnItemDoubleTapped"
                          KeyDown="OnListKeyDown"
                          ContextRequested="OnListContextRequested"
                          ContainerContentChanging="OnContainerContentChanging"
                          CanDragItems="True" DragItemsStarting="OnDragItemsStarting"
                          AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryItem">
                            <Grid ToolTipService.ToolTip="{x:Bind ToolTip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="0" />
                                    <ColumnDefinition Width="0" />
                                    <ColumnDefinition Width="0" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Grid Width="16">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Visibility="{x:Bind IsFolder}" />
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Visibility="{x:Bind IsFile}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Style="{StaticResource Secondary}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{x:Bind PackedText}" Style="{StaticResource Secondary}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{x:Bind RatioText}" Style="{StaticResource Secondary}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{x:Bind MethodText}" Style="{StaticResource Secondary}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind ModifiedText}" Style="{StaticResource Secondary}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Boş klasör ya da sonuçsuz arama -->
                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsHitTestVisible="False"
                           Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsListEmpty, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
