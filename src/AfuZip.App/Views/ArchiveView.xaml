<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AfuZip.App.Views.ArchiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AfuZip.App.ViewModels"
    xmlns:views="using:AfuZip.App.Views">

    <Grid x:Name="Root" RowSpacing="8" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="Pane" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,2" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnExtractHereAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="P" Invoked="OnTogglePreviewAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Up" Invoked="OnUpAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Komutlar, konum, arama -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" IsDynamicOverflowEnabled="False">
                <AppBarButton Icon="Download" Label="Çıkar" IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Buraya akıllı çıkar" Click="OnExtractHere" KeyboardAcceleratorTextOverride="Ctrl+E" />
                            <MenuFlyoutItem Text="Seçilenleri buraya çıkar" Click="OnExtractSelectionHere"
                                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Seçilenleri klasöre çıkar…" Click="OnExtractSelectionTo"
                                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                            <MenuFlyoutItem Text="Tümünü klasöre çıkar…" Click="OnExtractAllTo" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Label="Test et" Click="OnTest" IsEnabled="{x:Bind ViewModel.HasArchive, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Icon="Add" Label="Ekle" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                              ToolTipService.ToolTip="Dosya veya klasör ekle (ya da listeye sürükleyin)">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Dosya ekle…" Click="OnAddFiles" />
                            <MenuFlyoutItem Text="Klasör ekle…" Click="OnAddFolder" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Delete" Label="Sil" Click="OnDelete" IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                              ToolTipService.ToolTip="Seçilenleri arşivden sil (Del)" />
                <AppBarButton Icon="Rename" Label="Yeniden adlandır" Click="OnRename" IsEnabled="{x:Bind ViewModel.CanRename, Mode=OneWay}"
                              ToolTipService.ToolTip="Yeniden adlandır (F2)" />
                <AppBarSeparator />
                <AppBarButton Icon="Up" Label="Yukarı" Click="OnUp" IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}" />
                <AppBarToggleButton Label="Önizleme" IsChecked="{x:Bind ViewModel.IsPreviewVisible, Mode=TwoWay}">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE8A1;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
            </CommandBar>

            <BreadcrumbBar Grid.Column="1" VerticalAlignment="Center"
                           ItemsSource="{x:Bind ViewModel.Breadcrumb}"
                           ItemClicked="OnBreadcrumbClicked" />

            <TextBox x:Name="SearchBox" Grid.Column="2" VerticalAlignment="Center"
                     PlaceholderText="Arşivde ara (Ctrl+F)"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <!-- Üç panel: klasör ağacı · liste · önizleme -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Pane}" Padding="4,8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TreeView x:Name="FolderTree" ItemsSource="{x:Bind ViewModel.FolderRoots}" SelectionMode="Single"
                              CanDragItems="False" CanReorderItems="False" AllowDrop="False"
                              ItemInvoked="OnFolderInvoked">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <Expander Grid.Row="1" Header="Arşiv bilgisi" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock Text="{x:Bind ViewModel.ArchiveInfo, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Expander>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Pane}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Sıralanabilir kolon başlıkları: tıklayınca sırala, tekrar tıklayınca yönü değiştir -->
                    <Grid Padding="16,6,12,6" ColumnSpacing="12"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left" Tag="Name" Click="OnSortClick"
                                Content="{x:Bind ViewModel.NameHeader, Mode=OneWay}" />
                        <Button Grid.Column="1" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Tag="Size" Click="OnSortClick"
                                Content="{x:Bind ViewModel.SizeHeader, Mode=OneWay}" />
                        <Button Grid.Column="2" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Tag="PackedSize" Click="OnSortClick"
                                Content="{x:Bind ViewModel.PackedHeader, Mode=OneWay}" />
                        <Button Grid.Column="3" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Tag="Ratio" Click="OnSortClick"
                                Content="{x:Bind ViewModel.RatioHeader, Mode=OneWay}" />
                        <Button Grid.Column="4" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left" Tag="Method" Click="OnSortClick"
                                Content="{x:Bind ViewModel.MethodHeader, Mode=OneWay}" />
                        <Button Grid.Column="5" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left" Tag="Modified" Click="OnSortClick"
                                Content="{x:Bind ViewModel.ModifiedHeader, Mode=OneWay}" />
                    </Grid>

                    <ListView x:Name="EntriesList" Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Items}"
                              SelectionMode="Extended"
                              IsDoubleTapEnabled="True"
                              SelectionChanged="OnSelectionChanged"
                              DoubleTapped="OnItemDoubleTapped"
                              KeyDown="OnListKeyDown"
                              AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:EntryItem">
                                <Grid Height="32" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PackedText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind RatioText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind MethodText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ModifiedText}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Önizleme: genişliği ayraçla değişir (Monaco ve PDF için 340 px dar kalıyordu) -->
            <views:SplitterHandle x:Name="PreviewSplitter" Grid.Column="2" Margin="-8,0"
                                  Visibility="{x:Bind ViewModel.IsPreviewVisible, Mode=OneWay}" />
            <Border x:Name="PreviewHost" Grid.Column="3" Width="440" Padding="0" Style="{StaticResource Pane}"
                    Visibility="{x:Bind ViewModel.IsPreviewVisible, Mode=OneWay}" />
        </Grid>

        <TextBlock Grid.Row="2" Margin="4,0" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
    </Grid>
</UserControl>
