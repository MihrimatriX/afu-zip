<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AfuZip.App.Views.PreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:preview="using:AfuZip.Core.Preview">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Başlık: ad, tür · boyut · kodlama, kodlama seçici -->
        <!-- Tek satır başlık (alt panelde yer kaplamasın): ad, tür ve boyut, kodlama seçici -->
        <Grid Padding="12,0,6,0" MinHeight="34" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasHeader, Mode=OneWay}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" MaxWidth="420"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <ComboBox Grid.Column="2" VerticalAlignment="Center" MinWidth="120" MaxWidth="200" Padding="10,3"
                      ItemsSource="{x:Bind ViewModel.Encodings}"
                      SelectedIndex="{x:Bind ViewModel.EncodingIndex, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.CanChooseEncoding, Mode=OneWay}"
                      ToolTipService.ToolTip="Metin kodlaması" />
        </Grid>

        <!-- Hex veya resim yüzeyindeyken açıklama (ör. "HEIF codec'i yüklü değil") -->
        <InfoBar Grid.Row="1" Margin="10,8,10,0" IsClosable="False" Severity="Informational"
                 IsOpen="{x:Bind ViewModel.HasBanner, Mode=OneWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

        <Grid Grid.Row="2">
            <!-- Seçim yok -->
            <TextBlock Text="Önizlemek için bir dosya seçin" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <!-- Bilgi kartı -->
            <ScrollViewer Visibility="{x:Bind ViewModel.IsInfoVisible, Mode=OneWay}">
                <StackPanel Padding="14,12" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.Details, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button Content="{x:Bind ViewModel.LoadAnywayText, Mode=OneWay}" Click="OnLoadAnyway"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.CanLoadAnyway, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Düz metin yedeği (web katmanı yoksa) -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                          Visibility="{x:Bind ViewModel.IsTextVisible, Mode=OneWay}">
                <TextBlock Padding="14,10" Text="{x:Bind ViewModel.PlainText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"
                           FontSize="12" IsTextSelectionEnabled="True" />
            </ScrollViewer>

            <!-- Resim: yakınlaştırılabilir; açılışta panele sığdırılır -->
            <ScrollViewer x:Name="ImageScroller" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="16"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          Visibility="{x:Bind ViewModel.IsImageVisible, Mode=OneWay}"
                          DoubleTapped="OnImageDoubleTapped">
                <Image x:Name="PreviewImage" Source="{x:Bind ViewModel.Image, Mode=OneWay}" Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center" ImageOpened="OnImageOpened" />
            </ScrollViewer>

            <!-- Video ve ses -->
            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" AutoPlay="False"
                                Source="{x:Bind ViewModel.Media, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsMediaVisible, Mode=OneWay}" />

            <!-- Hex: satırlar yalnızca görünürken okunur (HexDocument sanal liste) -->
            <ListView x:Name="HexList" SelectionMode="Single" Padding="0,4"
                      ItemsSource="{x:Bind ViewModel.Hex, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsHexVisible, Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="20" />
                        <Setter Property="Height" Value="20" />
                        <Setter Property="Padding" Value="14,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="preview:HexRow">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{x:Bind OffsetText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind HexText}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            <TextBlock Text="{x:Bind AsciiText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- WebView2 ilk web önizlemesinde kodda oluşturulur (açılışı yavaşlatmasın) -->
            <Border x:Name="WebHost" Visibility="{x:Bind ViewModel.IsWebVisible, Mode=OneWay}" />

            <!-- Yükleniyor -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" />
                <TextBlock Text="{x:Bind ViewModel.LoadingText, Mode=OneWay}" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
