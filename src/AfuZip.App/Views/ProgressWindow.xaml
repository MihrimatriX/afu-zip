<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AfuZip.App.Views.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AfuZip.App.ViewModels"
    Title="AFU Zip">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Sağ tık menüsünden başlatılan işler: ana pencereyi açmadan küçük bir ilerleme penceresi. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="14,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="AFU Zip" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1" Padding="8,0" ItemsSource="{x:Bind Jobs}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ShellJob">
                    <Grid Padding="4,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind Task.Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Value="{x:Bind Task.Percent, Mode=OneWay}" Maximum="100"
                                         IsIndeterminate="{x:Bind Task.IsIndeterminate, Mode=OneWay}"
                                         Visibility="{x:Bind Task.IsActive, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Task.StatusText, Mode=OneWay}" TextWrapping="Wrap" MaxLines="3"
                                       Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton Padding="0" Content="Klasörü aç" Click="OnReveal" Tag="{x:Bind}"
                                             Visibility="{x:Bind CanReveal, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                            <Button ToolTipService.ToolTip="Duraklat" Click="OnPause" Tag="{x:Bind}"
                                    Visibility="{x:Bind Task.CanPause, Mode=OneWay}">
                                <FontIcon Glyph="&#xE769;" FontSize="12" />
                            </Button>
                            <Button ToolTipService.ToolTip="Devam et" Click="OnResume" Tag="{x:Bind}"
                                    Visibility="{x:Bind Task.CanResume, Mode=OneWay}">
                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                            </Button>
                            <Button ToolTipService.ToolTip="İptal" Click="OnCancel" Tag="{x:Bind}"
                                    Visibility="{x:Bind Task.IsActive, Mode=OneWay}">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Padding="16,10,16,14" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Summary" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="Kapat" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
